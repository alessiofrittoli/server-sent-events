{
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#00000000",
    "titleBar.border": "#3763CB",
    "titleBar.activeForeground": "#F0F0F0",
    "statusBar.background": "#191919",
    "statusBar.border": "#3763CB",
    "statusBar.foreground": "#F0F0F0",
    "activityBar.activeBorder": "#3763CB",
    "activityBarBadge.foreground": "#F0F0F0",
    "activityBarBadge.background": "#3763CB"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "files.associations": {
    ".ignore": "ignore",
    ".gitignore": "ignore"
  },
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "json.schemaDownload.trustedDomains": {
    "https://raw.githubusercontent.com/DavidAnson/markdownlint/": true
  }
}
